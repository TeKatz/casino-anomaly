; Engine configuration file.
config_version=5

[application]
config/name="Casino Anomaly"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]
LoopState="*res://gameplay/loop_state.gd"
GameSettings="*res://gameplay/settings.gd"

[editor_plugins]
enabled=PackedStringArray("res://addons/casino_model_preview/plugin.cfg")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
# Reduce texture shimmering in fine repeating PBR wall, floor and roof patterns.
anti_aliasing/quality/use_taa=true
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/texture_mipmap_bias=0.25
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.055, 1)
